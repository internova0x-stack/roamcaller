# Copy to .env and fill in. Never commit .env.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roam_caller

# Partner API
PORT=4000
LOG_LEVEL=info

# RoamBuddy partner API, one account per mode.
# Test-mode partner keys use the sandbox; live-mode keys use live.
# For local work, run `pnpm mock:roambuddy` and point the sandbox URL at it.
ROAMBUDDY_SANDBOX_URL=http://localhost:4100/api/v1
ROAMBUDDY_SANDBOX_USERNAME=
ROAMBUDDY_SANDBOX_PASSWORD=
ROAMBUDDY_LIVE_URL=https://api.worldroambuddy.com:3001/api/v1
ROAMBUDDY_LIVE_USERNAME=
ROAMBUDDY_LIVE_PASSWORD=
# The docs send the token as the raw Authorization value. Set to "bearer" if RoamBuddy says otherwise.
ROAMBUDDY_AUTH_SCHEME=raw

# Worker
WALLET_ALERT_USD=200
ALERT_EMAIL=
