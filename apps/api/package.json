{
  "name": "@roam/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "partner:create": "tsx --env-file-if-exists=../../.env scripts/create-partner.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fx:set": "tsx --env-file-if-exists=../../.env scripts/set-fx.ts",
    "partner:credit": "tsx --env-file-if-exists=../../.env scripts/credit-partner.ts"
  },
  "dependencies": {
    "@roam/core": "workspace:*",
    "@roam/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "exports": {
    "./app": "./src/app.ts"
  }
}
